cc_binary {
    name: "nvmd",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["nvmd.imx.rc"],
    srcs: [
        "nvmd.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
    static_libs: [
        "libsecureenclave",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
