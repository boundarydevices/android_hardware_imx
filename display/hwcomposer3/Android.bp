package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
    name: "hwc_config_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "nxp_hwc",
    variables: [
        "overlay_ip",
        "g2d_ip",
    ],
    properties: [
        "cflags",
    ],
}

soong_config_string_variable {
    name: "overlay_ip",
    values: ["DCSS", "DPU"],
}

soong_config_string_variable {
    name: "g2d_ip",
    values: ["DPU", "VIV"],
}

hwc_config_cc_defaults {
    name: "hwc_config_defaults",
    soong_config_variables: {
        overlay_ip: {
            DCSS: {
                cflags: ["-DOVERLAY_LIMITATION_DCSS"],
            },
            DPU: {
                cflags: ["-DOVERLAY_LIMITATION_DPU"],
            },
        },
        g2d_ip: {
            DPU: {
                cflags: ["-DG2D_LIMITATION_DPU"],
            },
            VIV: {
                cflags: ["-DG2D_LIMITATION_VIV"],
            },
        },
    },
}

cc_binary {
    name: "android.hardware.graphics.composer3-service.imx",
    defaults: ["libnxp_gralloc_v5_default", "hwc_config_defaults"],
    relative_install_path: "hw",
    init_rc: ["hwc3.rc"],
    vintf_fragments: ["hwc3.xml"],
    vendor: true,

    include_dirs: [
        "system/core/include/utils",
        "frameworks/native/include",
        "device/nxp/common/kernel-headers",
        "vendor/nxp/wsialloc/android/src",
        "vendor/nxp/wsialloc/android/src/include",
    ],

    shared_libs: [
        "android.hardware.graphics.composer@2.1-resources",
        "android.hardware.graphics.composer@2.2-resources",
        "android.hardware.graphics.composer3-V2-ndk",
        "android.hardware.graphics.mapper@2.0",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libbinder_ndk",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libsync",
        "libjsoncpp",
        "libui",
        "libvndksupport",
        "libdrm_android",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "libyuv_static",
        "libmath",
        "libnxp_gralloc_driver",
        "libnxp_gralloc_utils",
        "libhwsecureclient",
        "libtrusty",
        "libgralloc_internal_format",
        "libgralloc_core",
    ],
    srcs: [
        "BufferInfo.cpp",
        "ClientFrameComposer.cpp",
        "Common.cpp",
        "Composer.cpp",
        "ComposerClient.cpp",
        "ComposerResources.cpp",
        "Device.cpp",
        "DeviceComposer.cpp",
        "Display.cpp",
        "DisplayConfig.cpp",
        "DisplayFinder.cpp",
        "Drm.cpp",
        "DrmAtomicRequest.cpp",
        "DrmBuffer.cpp",
        "DrmClient.cpp",
        "DrmConnector.cpp",
        "DrmCrtc.cpp",
        "DrmDisplay.cpp",
        "DrmEventListener.cpp",
        "DrmMode.cpp",
        "DrmPlane.cpp",
        "DummyClient.cpp",
        "Edid.cpp",
        "FbdevClient.cpp",
        "FbdevDisplay.cpp",
        "Layer.cpp",
        "Main.cpp",
        "PollThread.cpp",
        "VsyncThread.cpp",
    ],
    cflags: [
        "-DLOG_TAG=\"NxpHWC3\"",
    ],
}

