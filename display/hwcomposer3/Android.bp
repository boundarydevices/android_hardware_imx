soong_namespace { }

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
    name: "hwc_config_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "nxp_hwc",
    variables: [
        "overlay_ip",
        "g2d_ip",
    ],
    properties: [
        "cflags",
    ],
}

soong_config_string_variable {
    name: "overlay_ip",
    values: ["DCSS", "DPU95"],
}

soong_config_string_variable {
    name: "g2d_ip",
    values: ["DPU", "DPU95", "VIV", "PXP"],
}

hwc_config_cc_defaults {
    name: "hwc_config_defaults",
    soong_config_variables: {
        overlay_ip: {
            DCSS: {
                cflags: ["-DOVERLAY_LIMITATION_DCSS"],
            },
            DPU95: {
                cflags: ["-DOVERLAY_LIMITATION_DPU"],
            },
        },
        g2d_ip: {
            DPU: {
                cflags: ["-DG2D_LIMITATION_DPU",
                         "-DG2D_FORMAT_CONVERSION",
                        ],
            },
            DPU95: {
                cflags: ["-DG2D_LIMITATION_DPU"],
            },
            VIV: {
                cflags: ["-DG2D_LIMITATION_VIV"],
            },
            PXP: {
                cflags: ["-DG2D_LIMITATION_PXP"],
            },
        },
    },
}

soong_config_module_type {
    name: "hwc_config_soc_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "IMXPLUGIN",
    variables: [
        "BOARD_SOC_TYPE",
    ],
    properties: [
        "cflags",
    ],
}

soong_config_string_variable {
    name: "BOARD_SOC_TYPE",
    values: ["IMX8Q", "IMX8MM", "IMX8MQ", "IMX8MP", "IMX8MN", "IMX8ULP", "IMX93", "IMX95"],
}

hwc_config_soc_cc_defaults {
    name: "hwc_config_soc_defaults",
    soong_config_variables: {
        BOARD_SOC_TYPE: {
            IMX8Q: {
                cflags: ["-DMAX_DRM_CONFIG_4K",],
            },
            IMX8MQ: {
                cflags: ["-DMAX_DRM_CONFIG_4K"],
            },
            IMX8MP: {
                cflags: ["-DMAX_DRM_CONFIG_4K",
                         "-DFIX_HANG_WHEN_FIRST_PLUG_IN",
                        ],
            },
            IMX95: {
                cflags: ["-DMAX_DRM_CONFIG_4K"],
            },
            IMX8ULP: {
                cflags: ["-DMAX_DRM_CONFIG_720P"],
            },
            IMX93: {
                cflags: ["-DFORMAT_WORKAROUND_FOR_PXP"],
            },
        },
    },
}

cc_binary {
    name: "android.hardware.graphics.composer3-service.imx",
    defaults: [
        "android.hardware.graphics.composer3-ndk_shared",
        "arm_gralloc_uses_libformat_defaults",
        "libnxp_gralloc_v5_defaults",
        "hwc_config_defaults",
        "hwc_config_soc_defaults",
    ],
    relative_install_path: "hw",
    init_rc: ["hwc3.rc"],
    vintf_fragments: ["hwc3.xml"],
    vendor: true,

    include_dirs: [
        "system/core/include/utils",
        "frameworks/native/include",
        "device/nxp/common/kernel-headers",
        "vendor/nxp/wsialloc/android/src",
        "vendor/nxp/wsialloc/android/src/include",
    ],

    shared_libs: [
        "android.hardware.graphics.composer@2.1-resources",
        "android.hardware.graphics.composer@2.2-resources",
        "libbase",
        "libbinder_ndk",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libhardware",
        "libsync",
        "libjsoncpp",
        "libui",
        "libvndksupport",
        "libdrm_android",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "libyuv_static",
        "libmath",
        "libnxp_gralloc_driver",
        "libhwsecureclient",
        "libtrusty",
        "libgralloc_internal_format",
        "libgralloc_core",
    ],
    srcs: [
        "BufferInfo.cpp",
        "ClientFrameComposer.cpp",
        "Common.cpp",
        "Composer.cpp",
        "ComposerClient.cpp",
        "ComposerResources.cpp",
        "Device.cpp",
        "DeviceComposer.cpp",
        "Display.cpp",
        "DisplayConfig.cpp",
        "DisplayFinder.cpp",
        "Drm.cpp",
        "DrmAtomicRequest.cpp",
        "DrmBuffer.cpp",
        "DrmClient.cpp",
        "DrmConnector.cpp",
        "DrmCrtc.cpp",
        "DrmDisplay.cpp",
        "DrmEventListener.cpp",
        "DrmMode.cpp",
        "DrmPlane.cpp",
        "DummyClient.cpp",
        "Edid.cpp",
        "FbdevClient.cpp",
        "FbdevDisplay.cpp",
        "FenceMonitor.cpp",
        "HDCPThread.cpp",
        "Layer.cpp",
        "Main.cpp",
        "PollThread.cpp",
        "VsyncThread.cpp",
    ],
    cflags: [
        "-DLOG_TAG=\"NxpHWC\"",
        "-Wall",
        "-Wthread-safety",
        "-Wno-invalid-offsetof",
    ],
}

