package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_shared {
    name: "mapper.imx",
    defaults: ["libnxp_gralloc_v5_defaults"],
    vintf_fragments: ["mapper.imx.xml"],

    relative_install_path: "hw",
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "libgralloctypes",
        "libhidlbase",
        "libbase",
        "libutils",
        "libdrm_android",
    ],
    header_libs: [
        "libbase_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
    ],
    static_libs: [
        "libnxp_gralloc_driver",
    ],
    srcs: [
        "Mapper.cpp",
        "registered_handle_pool.cpp",
    ],
    cpp_std: "c++20",
    cflags: [
        "-Wno-sign-compare",
        "-DLOG_TAG=\"NxpMapper\""
    ],
}
